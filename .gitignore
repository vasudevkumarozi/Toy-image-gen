# Secrets — never commit these. Real values live only in .env / the key
# files on disk (or on the deploy instance); .env.example is the template
# and is safe to commit.
.env
gcp_key*.json
gcs_key*.json

# OS / editor cruft
.DS_Store
__pycache__/
*.pyc
venv/
.venv/

# Bulk-run artifacts — regenerated by running the pipeline, not source.
# Checkpoints/status files are per-run progress state (see README's
# "Bulk runs" section), not something to version.
generated_images*/
*.checkpoint.jsonl
*.status.json

# Ad-hoc run outputs from local testing (products_detail_*.csv,
# classification_result_*.csv, final_output_*.xlsx, products_6_images_*.xlsx,
# run_*.xlsx, run_batch2_input.csv, etc.) — these are this session's actual
# product data pulled from the live admin API, not fixtures the repo needs.
/products_detail*.csv
/classification_result*.csv
/final_output*.xlsx
/products_6_images*.xlsx
/run_*.xlsx
/run_batch2_input.csv
