# Copy this file to .env and fill in your real values, then load it with:
#   set -a; source .env; set +a
# (NOT `export $(grep -v '^#' .env | xargs)` — that silently truncates any
# value containing a space, e.g. GCS_PREFIX). Quote values with spaces, as
# GCS_PREFIX is below. NEVER commit .env or paste these values anywhere public.

# --- Step 1: OZi Admin Panel ---
# A long-lived API key, not a session bearer token — doesn't expire in ~24h.
OZI_API_KEY=

# --- Steps 2 & 3: Google Cloud / Vertex AI ---
# Same service account and project cover both classification (step 2, Gemini
# vision) and generation (step 3, Gemini image editing) — one set of GCP
# credentials, no separate Anthropic account needed. The service account
# needs the "Vertex AI User" role.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json
GCP_PROJECT_ID=
GCP_REGION=us-central1
# Optional overrides:
# GEMINI_CLASSIFY_MODEL=gemini-2.5-flash    (step 2 default)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image  (step 3 default, "Nano Banana 2")

# --- Optional: auto-upload generated images to GCS (step 3) ---
# Leave unset to skip auto-upload — GCP_Link stays blank for manual upload.
# GCS_BUCKET may include a "/prefix" suffix, e.g. "my-bucket/toys/generated".
# GCS_CREDENTIALS can be the same file as GOOGLE_APPLICATION_CREDENTIALS if
# that service account also has a Storage role, or a separate key.
# Quote GCS_PREFIX if it contains a space, e.g. GCS_PREFIX="toys test".
# GCS_BUCKET=
# GCS_PREFIX=
# GCS_CREDENTIALS=
